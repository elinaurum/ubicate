# Copiar a .env y ajustar. Nunca versionar .env con claves reales.

UBICATE_ENTORNO=local
UBICATE_LOG_NIVEL=INFO
UBICATE_LOG_FORMATO=texto

# Chat --------------------------------------------------------------------
# Proveedor: eco | gemini | groq | anthropic | openai | compatible
#   eco  → sin modelo de lenguaje, responde con la base. No necesita key.
UBICATE_PROVEEDOR_LLM=eco
UBICATE_MODELO_LLM=
UBICATE_API_KEY=

# Recetas listas. Descomenta UNA y pega tu key arriba.
#

Gemini (Google AI Studio) — recomendado para partir: gratis, sin tarjeta.
#   Key en https://aistudio.google.com/apikey · pip install openai
#   Google retira modelos seguido: si da error 404, ejecuta
#   `python scripts/probar_proveedor.py` y te dirá cuál usar.
UBICATE_PROVEEDOR_LLM=gemini
UBICATE_MODELO_LLM=gemini-3.6-flash
# Nivel de razonamiento: minimal | low | medium | high | 0 | -1 | auto
# Súbelo solo si las respuestas quedan pobres. Consume UBICATE_MAX_TOKENS.
UBICATE_NIVEL_PENSAMIENTO=medium
#
# Groq — gratis y muy rápido, pero con límite de tokens por minuto bajo.
#   Key en https://console.groq.com/keys · pip install openai
# UBICATE_PROVEEDOR_LLM=groq
# UBICATE_MODELO_LLM=llama-3.3-70b-versatile
#
# Anthropic — de pago. pip install anthropic
# UBICATE_PROVEEDOR_LLM=anthropic
# UBICATE_MODELO_LLM=claude-sonnet-4-5
#
# OpenAI — de pago. pip install openai
# UBICATE_PROVEEDOR_LLM=openai
# UBICATE_MODELO_LLM=gpt-4o-mini
#
# Cualquier otro endpoint compatible con OpenAI (Ollama, OpenRouter, un proxy
# de la facultad). Exige base_url.
# UBICATE_PROVEEDOR_LLM=compatible
# UBICATE_BASE_URL=http://localhost:11434/v1
# UBICATE_MODELO_LLM=llama3.1

# Límites por sesión (protegen costo y disponibilidad)
UBICATE_MENSAJES_POR_SESION=60
UBICATE_SEGUNDOS_ENTRE_MENSAJES=1.0

# Búsqueda ----------------------------------------------------------------
UBICATE_UMBRAL_DIFUSO=0.72
UBICATE_MAX_SUGERENCIAS=5

# Métricas ----------------------------------------------------------------
UBICATE_METRICAS_ACTIVAS=true
